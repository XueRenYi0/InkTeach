<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      **OutputType 默认是 Exe（控制台子系统）——这是故意的**：这个仓库的干活方式就是
      "跑一条自检、看它的输出"，而输出要被管道抓住就必须是控制台子系统
      （GUI 子系统进程拿不到父进程的管道：实测改成 WinExe 之后，
      自检的输出被管道抓到的却是空的那一份）。

      发布给用户时切到 GUI 子系统（那样双击启动不会弹黑框），根目录 publish.ps1 会传
      `PublishAsWinExe=true` 过来。两条路各管一截。
      （发布版从终端跑时，Main 里那句 AttachConsole 会让日志照旧打到那个终端上。）

      ⚠ **别改成"命令行直接传 OutputType=WinExe"**：那是 MSBuild 的**全局属性**，
      会一起传给被引用的 InkEngine / InkUi——它们是库、没有 Main，
      整个构建直接报 CS5001（这个坑实测踩过，所以专门开了这个自定义开关）。

      程序图标 = **线条型的笔 · 白纸（带笔锋的红色笔迹）**（用户 2026-10-01 第五轮定的；
      设计稿 design/图标-设计稿v5-线条型的笔.png 与 v5b-笔迹四选.png 的 B / ②）。
      它不是手绘的，是 makeicon 那条命令用界面的渲染路径画出来的（画在 AppIconUi 里），见 App.MakeIcon。

      版本从 8.0.0 起（用户 2026-09-27 定）。文件属性里那几行都跟着它走。
    -->
    <OutputType Condition="'$(PublishAsWinExe)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(PublishAsWinExe)' != 'true'">Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>InkTeach</AssemblyName>
    <RootNamespace>InkTeach</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <ApplicationIcon>assets\InkTeach.ico</ApplicationIcon>

    <Version>8.11.1</Version>
    <!--
      ⚠ **不要再单独钉 `AssemblyVersion` / `FileVersion`**（2026-10-02 踩过）：
      这两个一旦和上面的 `<Version>` 分家，`UpdateFeed.CurrentVersion`（读程序集版本）
      就会比真实版本旧——8.6.0 装完仍报"当前 8.5.1"，于是永远提示"有新版本 8.6.0"。
      SDK 默认让它们跟着 `<Version>` 走，别动就是对的。
    -->
    <Product>InkTeach 批注</Product>
    <AssemblyTitle>InkTeach 批注</AssemblyTitle>
    <Description>屏幕批注工具：白板 / PPT 放映批注 / 图形与曲线 / 回放导出</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkEngine\InkEngine.csproj" />
    <ProjectReference Include="..\InkUi\InkUi.csproj" />
  </ItemGroup>

  <!-- 引擎库里的 Vortice 类型会出现在公开签名里，这里需要能引用到 -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

  <!--
    PDFium 原生库（PDF 渲染）：**不进 git**（7.15MB 二进制），在 `vendor\pdfium-win-x64\bin\`
    —— 跑 `tools/fetch-pdfium.ps1` 取回。它在就拷到输出目录（开发/自检直接用）；
    不在也能编译（PDF 那条路会提示"缺 pdfium.dll"，其它功能一切照旧）。
    发布包由根目录 publish.ps1 负责把它放进 dist（那里缺了会直接报错，避免漏带）。
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\vendor\pdfium-win-x64\bin\pdfium.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\vendor\pdfium-win-x64\bin\pdfium.dll"
          Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
