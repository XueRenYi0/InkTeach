<Project Sdk="Microsoft.NET.Sdk">

  <!--
    产品界面层。

    它只认引擎的三个接口（IOverlayUi / IUiHost / IEngineCommands），
    不认识文档模型、不认识笔迹——改引擎状态一律走命令。
    规矩见 架构-分层与规则.md 与 计划-底层对接界面.md。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>InkUi</AssemblyName>
    <RootNamespace>InkUi</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkEngine\InkEngine.csproj" />
  </ItemGroup>

  <!-- 开发期宿主（InkTeach）的自检要能看到界面的内部状态：格子矩形、展开状态。
       产品代码只走 IOverlayUi 那套公开接口。和引擎那边同一个套路。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>InkTeach</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- 引擎的公开签名里有 Vortice 类型（ID2D1DeviceContext / Color4），这里要能引用到 -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

</Project>
