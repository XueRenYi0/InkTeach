<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>InkProbe</AssemblyName>
    <RootNamespace>InkProbe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkEngine\InkEngine.csproj" />
    <!-- 可选的笔迹优化层。不引用它、不注册优化器，跑的就是纯底层。 -->
    <ProjectReference Include="..\InkEngine.Optimize\InkEngine.Optimize.csproj" />
  </ItemGroup>

  <!-- 引擎库里的 Vortice 类型会出现在公开签名里，这里需要能引用到 -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

</Project>
