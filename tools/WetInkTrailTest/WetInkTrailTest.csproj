<Project Sdk="Microsoft.NET.Sdk">

  <!--
    湿墨迹 → DComp（委托墨迹轨迹）最小测试。
    技术栈对齐 InkTeach：Vortice + Direct2D + DirectComposition，其余（文档、UI、干墨）全部自己画。
    目标框架本机用 net8.0（本机 SDK 是 8.0.x）；拷进 net10 工程无需改一行代码。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WetInkTrailTest</AssemblyName>
    <RootNamespace>WetInkTrailTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

</Project>
